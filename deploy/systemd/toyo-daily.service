[Unit]
Description=Toyo daily full fetch -> toyo-data publish

[Service]
Type=oneshot
WorkingDirectory=/home/penne/dev/scratch/toyo-univ-analyze
Environment=PATH=/home/penne/.volta/bin:/usr/bin:/bin
# watch が実行中ならロック解放を最大 15 分待つ（04:30 は watch の起動時刻と重なるため -n にしない）
ExecStart=/usr/bin/flock -w 900 /tmp/toyo-fetch.lock /usr/bin/env npm run toyo:daily
# 全取得は 600 秒を超えうるため watch より長く取る
TimeoutStartSec=1800
# 成否を記録し、連続失敗が閾値に達したら通知する（失敗しても本体の結果は変えないので `-` 付き）
ExecStopPost=-/usr/bin/bash deploy/toyo-health-hook.sh daily
