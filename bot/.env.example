# Required: Discord bot token
DISCORD_TOKEN=your-discord-bot-token

# Optional: guild ID for faster slash-command sync during development
DISCORD_GUILD_ID=123456789012345678

# Optional: command the bot runs for periodic sync
TOYO_SYNC_COMMAND="npm run toyo:sync"

# Optional: override the generated summary JSON path
TOYO_SUMMARY_PATH=/home/penne/dev/scratch/toyo-univ-analyze/output/bot/summary.json

# Optional: override the persisted bot config path
TOYO_DISCORD_CONFIG_PATH=/home/penne/dev/scratch/toyo-univ-analyze/state/discord-config.json

# Optional: override the notification deduplication state path
TOYO_NOTIFICATION_STATE_PATH=/home/penne/dev/scratch/toyo-univ-analyze/state/discord-notification-state.json
